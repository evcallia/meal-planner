# npm 12 (used by Renovate's lockfile updates) refuses registry tarballs of
# packages that declare bundleDependencies, misreading them as "remote" deps
# (npm/cli#9347) — that broke every Renovate lockfile update once Tailwind v4
# pulled in @tailwindcss/oxide-wasm32-wasi. "all" restores npm <=11 behavior.
# npm 11 warns "Unknown project config" about this key; harmless.
allow-remote=all
