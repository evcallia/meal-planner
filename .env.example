# Database
POSTGRES_DB=mealplanner
POSTGRES_USER=mealplanner
POSTGRES_PASSWORD=changeme

# Apple Calendar (CalDAV)
# Generate an app-specific password at https://appleid.apple.com/account/manage
APPLE_CALENDAR_EMAIL=your-apple-id@icloud.com
APPLE_CALENDAR_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional: comma-separated list of calendar names to sync (leave empty to use first calendar)
# Example: APPLE_CALENDAR_NAMES=Personal,Work,Family
APPLE_CALENDAR_NAMES=

# Household timezone (IANA) for calendar event times. An event saved on another
# zone is converted into this one before display, so a trip booked at 18:30
# Paris time shows at your local hour. Empty falls back to the container's TZ.
CALENDAR_TIMEZONE=America/Los_Angeles

# OIDC — any spec-compliant provider (Authentik, Authelia, Keycloak, ...).
# Leave OIDC_ISSUER empty to disable OIDC entirely (docs/auth.md).
OIDC_ISSUER=https://auth.yourdomain.com/application/o/meal-planner/
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
# Label for the login button ("Sign in with X")
OIDC_PROVIDER_NAME=SSO
# URL the frontend visits after logout to also end the provider session
# (e.g. Authelia's https://auth.yourdomain.com/logout). Empty = use the
# provider's discovered end_session_endpoint.
LOGOUT_URL=
# Username/password login (enabled by default; set false to disable).
# Create/update credentials with: server -set-password user@example.com
# or via Settings -> "Set password" while signed in.
PASSWORD_AUTH_ENABLED=true

# App
SECRET_KEY=generate-a-secure-random-key-here
FRONTEND_URL=http://localhost:8000
APP_PORT=8000
SECURE_COOKIES=true  # Set to true for HTTPS in production
DEBUG_TIMING=false   # Set to true to enable CalDAV timing logs
MEAL_HISTORY_RETENTION_DAYS=365  # How many days of past meal notes to keep (default: 365)
VAPID_SUBJECT=mailto:email@domain.com
PUSH_EDIT_WINDOW_MINUTES=30
